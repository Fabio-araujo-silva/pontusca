{
  "name": "@arquibancada/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "dev:sandbox": "cross-env DATABASE_URL=file:./sandbox.db SANDBOX_AUTOSTART=1 npm run sandbox:prepare && cross-env DATABASE_URL=file:./sandbox.db SANDBOX_AUTOSTART=1 nest start --watch",
    "sandbox:prepare": "prisma db push --skip-generate && ts-node -r tsconfig-paths/register src/seed/seed.ts",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "prisma db push --skip-generate && node dist/seed/seed.js && node dist/main.js",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "seed": "ts-node -r tsconfig-paths/register src/seed/seed.ts",
    "test": "jest",
    "logs": "node scripts/logs.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/websockets": "^10.4.22",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.0",
    "helmet": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.22",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "prisma": "^6.19.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register src/seed/seed.ts"
  }
}
