# Banco (SQLite). Em produção aponte pra um volume persistente: file:/data/arquibancada.db
DATABASE_URL="file:./dev.db"
# Segredo do JWT — gere um aleatório em produção (openssl rand -hex 32)
JWT_SECRET="troque-isto"
# Primeiro admin criado pelo seed (só se ainda não houver nenhum admin)
ADMIN_EMAIL="admin@arquibancada.app"
ADMIN_PASSWORD="arquibancada123"
ADMIN_NAME="Admin"
PORT=3000
# Origem do front em dev (CORS). Em produção o próprio Nest serve o front.
WEB_ORIGIN="http://localhost:5173"
# 1 = liga o simulador de sandbox no boot (usado por npm run dev:sandbox)
SANDBOX_AUTOSTART=0
